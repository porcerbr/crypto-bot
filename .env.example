# ═══════════════════════════════════════════════════════════════════════════════
# SNIPER BOT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env com chaves reais.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── OBRIGATÓRIAS ─────────────────────────────────────────────────────────────
# Token do bot Telegram (obtenha em @BotFather)
TELEGRAM_TOKEN=

# ID do chat ou grupo que receberá os sinais
# Para grupos: -100xxxxxxxxxx  |  Para usuário: número positivo
TELEGRAM_CHAT_ID=

# Chave da API Twelve Data (dados de mercado em tempo real)
# Conta gratuita em: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# ─── FORTEMENTE RECOMENDADAS ──────────────────────────────────────────────────
# Chave Google Gemini (validação por IA — bot opera sem ela, mas com qualidade reduzida)
# Obtenha grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token de autenticação do Dashboard (OBRIGATÓRIO em produção)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_TOKEN=

# ─── SIMULAÇÃO ────────────────────────────────────────────────────────────────
# Alavancagem padrão para cálculo de lote (simulação)
DEFAULT_LEVERAGE=500

# Saldo inicial simulado em USD
INITIAL_BALANCE=1000

# ─── PERSISTÊNCIA ─────────────────────────────────────────────────────────────
# Caminho do arquivo SQLite de estado
# Em Railway com volume: /data/bot_state.db
DB_PATH=bot_state.db

# Tempo de expiração de sinais pendentes (segundos)
PENDING_EXPIRY_SECONDS=7200

# ─── OPCIONAIS — BACKUP REMOTO ────────────────────────────────────────────────
# URL S3-compatible (Supabase Storage, AWS S3, Backblaze, etc.)
# Deixe vazio para desativar backup remoto
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
# Intervalo de backup em segundos (default: 1h)
BACKUP_INTERVAL=3600

# ─── OPCIONAIS — NOTIFICAÇÕES ADICIONAIS ──────────────────────────────────────
# Tópico ntfy.sh para push notifications no celular
# Exemplo: meu-bot-sinais  (https://ntfy.sh/meu-bot-sinais)
NTFY_TOPIC=

# ─── OPCIONAIS — LIMITES DE RISCO (Fase 4) ────────────────────────────────────
# Perda diária máxima (% do balance) — ao atingir, pausa até meia-noite UTC
MAX_DAILY_LOSS_PCT=5.0
# Perda semanal máxima (% do balance) — ao atingir, pausa até segunda-feira UTC
MAX_WEEKLY_LOSS_PCT=10.0
