# ─────────────────────────────────────────────────────────────────────────────
# TradingBot Professional — Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# NUNCA suba o arquivo .env para controle de versão.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambiente ─────────────────────────────────────────────────────────────────
ENV=development          # development | production
DEBUG=true
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ── Mercado ──────────────────────────────────────────────────────────────────
SYMBOL=BTC-USD           # Símbolo compatível com o provedor escolhido
TIMEFRAME=1h             # 1m | 5m | 15m | 1h | 4h | 1d
QUOTE_CURRENCY=USD

# ── Dados ────────────────────────────────────────────────────────────────────
DATA_PROVIDER=yfinance   # yfinance | binance
DATA_LOOKBACK_BARS=200
API_TIMEOUT_SECONDS=15
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=2.0

# ── Estratégia ───────────────────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_FAST=9
EMA_SLOW=21
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
MIN_SIGNAL_SCORE=65.0    # Score mínimo para gerar sinal (0-100)

# ── Risco ────────────────────────────────────────────────────────────────────
MAX_OPEN_TRADES=3
MAX_DAILY_TRADES=10
MAX_DRAWDOWN_PCT=5.0
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MIN_VOLUME_FACTOR=0.8

# ── Scheduler ────────────────────────────────────────────────────────────────
CYCLE_INTERVAL_SECONDS=300   # 300 = 5 minutos
HEALTH_CHECK_INTERVAL=60

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/bot.db
STATE_FILE=data/state.json

# ── Capital Simulado ─────────────────────────────────────────────────────────
INITIAL_CAPITAL=10000.0

# ── Alertas (opcional) ────────────────────────────────────────────────────────
# Para receber alertas no Telegram:
# 1. Crie um bot via @BotFather e copie o token
# 2. Encontre seu chat_id via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_SIGNAL=false
