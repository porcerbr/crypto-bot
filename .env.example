# Trading Bot Pro - Configurações de Ambiente

# Modo de operação: SIMULATION ou LIVE
OPERATION_MODE=SIMULATION

# Ativo principal (ex: BTC-USD, AAPL, EURUSD=X)
TRADING_SYMBOL=BTC-USD

# Intervalo de coleta em segundos
COLLECT_INTERVAL=60

# Timeframe da análise (1m, 5m, 15m, 1h, 1d)
TIMEFRAME=5m

# Janela de dados para análise (períodos)
LOOKBACK_PERIOD=100

# Risco Máximo por operação (% do capital)
MAX_RISK_PER_TRADE=2.0

# Exposição máxima simultânea (% do capital)
MAX_EXPOSURE=10.0

# Limite de operações abertas simultâneas
MAX_OPEN_TRADES=3

# Horário de operação (UTC)
TRADE_START_HOUR=9
TRADE_END_HOUR=21

# Filtros de volatilidade
MAX_VOLATILITY_PCT=5.0
MIN_VOLUME_RATIO=1.2

# Score mínimo para gerar sinal (0-100)
MIN_SIGNAL_SCORE=65

# API Keys (preencher se usar serviços externos)
# ALPHA_VANTAGE_KEY=sua_chave
# NEWS_API_KEY=sua_chave

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
SECRET_KEY=change-me-in-production-very-strong-key

# Database
DB_PATH=data_storage/bot_state.db

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
